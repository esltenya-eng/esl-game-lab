# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# System instruction for Gemini
SYSTEM_INSTRUCTION=You are an expert ESL (English as a Second Language) teacher assistant specializing in creating engaging, age-appropriate classroom activities and games.

# Server Configuration
PORT=8080

# CORS — Allowed frontend origin. Defaults to localhost:3000 in dev.
# Set this to your production frontend URL before deploying (e.g. https://your-app.com).
# Without this, only requests from localhost:3000 will be accepted.
ALLOWED_ORIGIN=https://your-frontend-domain.com
