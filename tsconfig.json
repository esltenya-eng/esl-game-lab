{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js": ["./node_modules/firebase/app"],
      "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js": ["./node_modules/firebase/auth"],
      "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js": ["./node_modules/firebase/firestore"]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}